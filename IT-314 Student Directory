/*html*/

<!DOCTYPE html><html lang="en"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Directory</title><link rel="stylesheet" href="style.css">

</head><body><header>
    <h1>Student Directory</h1>
    <p>Welcome to the Student Directory. Add and View student information below.</p>
</header>

<main>

    <form id="studentForm" class="student-form">

        <div class="field">
            <label for="studentName">Student Name:</label>
            <input type="text" id="studentName" name="studentName" required>
        </div>

        <div class="field">
            <label for="program">Program:</label>
            <input type="text" id="program" name="program" required>
        </div>

        <button type="submit" class="btn-add">Add Student</button>

    </form>

    <div id="student-list">
        <p class="empty-message">No students added yet.</p>
    </div>

</main>

<script src="script.js"></script>

</body>
</html>


/*css*/

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background: #ffffff;
  color: #222;
  line-height: 1.5;
}

header {
  text-align: center;
  padding: 28px 16px;
  background: #c81e1e;
  color: #000;
}

header h1 {
  font-size: 1.9rem;
}

header p {
  margin-top: 6px;
  opacity: 0.95;
}

main {
  max-width: 1000px;
  margin: 0 auto;
  padding: 24px 16px 50px;
}

.student-form {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  align-items: flex-end;
  justify-content: center;
  background: #969ba3;
  border: 1px solid #e0b8b8;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(200, 30, 30, 0.12);
  padding: 20px;
  margin-bottom: 28px;
}

.field {
  flex: 1 1 200px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.field label {
  font-weight: bold;
  font-size: 0.9rem;
  color: #000;
}

.field input {
  padding: 9px 10px;
  font-size: 1rem;
  border: 1px solid #ccc;
  border-radius: 5px;
}

.field input:focus {
  outline: none;
  border-color: #c81e1e;
}

.btn-add {
  flex: 0 0 100%;
  max-width: 220px;
  margin: 0 auto;
  padding: 10px 22px;
  font-size: 1rem;
  font-weight: bold;
  color: #000;
  background: #c81e1e;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

.btn-add:hover {
  background: #a11515;
}

#student-list {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14px;
}

.student-card {
  background: #fff;
  border: 1px solid #e0b8b8;
  border-top: 4px solid #c81e1e;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(200, 30, 30, 0.10);
  padding: 16px;
  text-align: center;
}

.student-card h3 {
  font-size: 1.05rem;
  color: #000;
  overflow-wrap: anywhere;
}

.student-card p {
  color: #555;
  font-size: 0.9rem;
  margin: 4px 0 10px;
  overflow-wrap: anywhere;
}

.btn-remove {
  padding: 6px 12px;
  font-size: 0.85rem;
  color: #000;
  background: #fff;
  border: 1px solid #c81e1e;
  border-radius: 5px;
  cursor: pointer;
}

.btn-remove:hover {
  background: #c81e1e;
  color: #fff;
}

.empty-message {
  grid-column: 1 / -1;
  text-align: center;
  color: #888;
  padding: 20px 0;
}

@media (max-width: 1024px) {
  #student-list {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 600px) {
  #student-list {
    grid-template-columns: 1fr;
  }
}

/*js*/

const studentForm = document.getElementById('studentForm');
const studentList = document.getElementById('student-list');

studentForm.addEventListener('submit', function (event) {

event.preventDefault();

const nameInput = document.getElementById('studentName');
const programInput = document.getElementById('program');

const studentName = nameInput.value.trim();
const studentProgram = programInput.value.trim();

if (studentName === '' || studentProgram === '') {
    return;
}

const emptyMessage = studentList.querySelector('.empty-message');
if (emptyMessage) {
    emptyMessage.remove();
}

const card = document.createElement('div');
card.classList.add('student-card');

card.innerHTML = `
    <h3>${studentName}</h3>
    <p><strong>Program:</strong> ${studentProgram}</p>
    <button type="button" class="btn-remove">Remove</button>
`;

const removeBtn = card.querySelector('.btn-remove');

removeBtn.addEventListener('click', function () {
    card.remove();

    if (studentList.children.length === 0) {
        studentList.innerHTML = `
            <p class="empty-message">No students added yet.</p>
        `;
    }
});

studentList.appendChild(card);

studentForm.reset();

});
